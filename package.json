{
  "name": "cims",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "index": "node scripts/gen-index.mjs",
    "index:check": "node scripts/gen-index.mjs --check",
    "setup:hooks": "git config core.hooksPath .githooks && git config merge.cims-generated.driver true",
    "data:check": "node scripts/data.mjs check",
    "data:verify": "node scripts/data.mjs verify",
    "data:list": "node scripts/data.mjs list",
    "db:check": "node scripts/db.mjs check",
    "db:status": "node scripts/db.mjs status",
    "db:apply": "node scripts/db.mjs apply",
    "db:accounts": "node scripts/db.mjs accounts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "maplibre-gl": "^4.7.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
